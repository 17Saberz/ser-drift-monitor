{
  "name": "SER Drift Monitoring Pipeline",
  "nodes": [
    {
      "id": "1",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [240, 300],
      "parameters": {
        "rule": {
          "interval": [{ "field": "hours", "hoursInterval": 1 }]
        }
      }
    },
    {
      "id": "2",
      "name": "Run Monitoring Pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "position": [460, 300],
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/run",
        "sendBody": true,
        "contentType": "json",
        "body": {
          "scenario": "baseline",
          "batch_size": 50,
          "noise_std": 1.0
        },
        "options": {}
      }
    },
    {
      "id": "3",
      "name": "Check Alert Status",
      "type": "n8n-nodes-base.if",
      "position": [680, 300],
      "parameters": {
        "conditions": {
          "boolean": [{
            "value1": "={{ $json.any_alert }}",
            "value2": true
          }]
        }
      }
    },
    {
      "id": "4",
      "name": "Send Alert Notification",
      "type": "n8n-nodes-base.emailSend",
      "position": [900, 200],
      "parameters": {
        "fromEmail": "monitor@ser-platform.com",
        "toEmail": "your-email@example.com",
        "subject": "=🚨 SER Drift Alert — {{ $json.scenario }}",
        "text": "=Drift detected!\n\nScenario: {{ $json.scenario }}\nKS Drift: {{ $json.ks_drift_ratio }}\nF1 Score: {{ $json.f1_score }}\nBaseline F1: {{ $json.baseline_f1 }}\nF1 Drop: {{ $json.f1_drop }}\n\nPlease review the Power BI monitoring dashboard."
      }
    },
    {
      "id": "5",
      "name": "Log OK Status",
      "type": "n8n-nodes-base.noOp",
      "position": [900, 400],
      "parameters": {}
    }
  ],
  "connections": {
    "Schedule Trigger":        { "main": [[{ "node": "Run Monitoring Pipeline", "type": "main", "index": 0 }]] },
    "Run Monitoring Pipeline": { "main": [[{ "node": "Check Alert Status",       "type": "main", "index": 0 }]] },
    "Check Alert Status": {
      "main": [
        [{ "node": "Send Alert Notification", "type": "main", "index": 0 }],
        [{ "node": "Log OK Status",           "type": "main", "index": 0 }]
      ]
    }
  },
  "_comment": {
    "setup": [
      "1. Start the API server: python src/api.py",
      "2. Import this JSON into n8n via Workflows > Import from File",
      "3. Update 'toEmail' in Send Alert Notification node",
      "4. Add SMTP credentials in Settings > Credentials",
      "5. Test manually then Activate"
    ]
  }
}
